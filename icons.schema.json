{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tech-stack-icons catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "category",
      "tags",
      "versions",
      "color"
    ],
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "altnames": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "category": {
        "enum": [
          "languages",
          "frameworks",
          "databases",
          "cloud",
          "devops",
          "ai",
          "editors-terminals",
          "operating-systems",
          "design",
          "data-analytics",
          "seo-webmaster",
          "messaging",
          "email",
          "productivity",
          "other"
        ]
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "versions": {
        "type": "object",
        "required": [
          "svg"
        ],
        "additionalProperties": false,
        "properties": {
          "svg": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "original",
                "original-wordmark",
                "plain",
                "plain-wordmark",
                "line",
                "line-wordmark"
              ]
            }
          }
        }
      },
      "color": {
        "type": "string",
        "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
      }
    }
  }
}
